# Loom Harness API & Environment Configuration

# API Security & Server Settings
API_KEY=your-secret-api-key-here
DASHBOARD_AUTH_TOKEN=your-dashboard-auth-token-here
ALLOWED_REPO_ROOTS=/var/repos,/app/workspaces
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
LOOM_LOG_LEVEL=INFO

# IMPORTANT SECURITY NOTICE FOR PRODUCTION:
# Never commit real API keys or credentials to version control.
# In production deployments, retrieve secrets at runtime using a secure secrets manager 
# such as HashiCorp Vault, AWS Secrets Manager, Azure Key Vault, or GCP Secret Manager.

# Model Routing & LLM Provider Keys
MODEL_DEFAULT=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Storage & Database Options
LOOM_DB_PATH=~/.loom/memory.db

# Telemetry & Observability Exporters
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Frontend & BFF Configuration
LOOM_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

