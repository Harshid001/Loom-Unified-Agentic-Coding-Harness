# Loom Harness API & Environment Configuration
LOOM_ENV=production
DEV_MODE=false
API_KEY=your-secret-api-key-here
API_KEY_USER_ID=dev_user
API_KEY_ORG_ID=default
DASHBOARD_AUTH_TOKEN=your-dashboard-auth-token-here
ALLOWED_REPO_ROOTS=/var/repos,/app/workspaces
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=redis://localhost:6379/0
TRUST_PROXY=false
LOOM_TOKEN_ADMIN_ENABLED=false
LOOM_TOKEN_TTL_SECONDS=86400
RATE_LIMIT_ALLOW_LOCAL_FALLBACK=false

# Sandbox
LOOM_SANDBOX_WORKER_URL=http://sandbox-worker:8100
SANDBOX_WORKER_TOKEN=replace-with-random-worker-token
SANDBOX_ALLOW_NETWORK=false

# Tier C Firecracker worker
LOOM_FIRECRACKER_WORKER_URL=http://firecracker-worker:8101
LOOM_FIRECRACKER_WORKER_TOKEN=replace-with-random-firecracker-worker-token
LOOM_FIRECRACKER_REPO_ROOT=/var/repos
LOOM_FIRECRACKER_RUNTIME_DIR=/var/lib/loom/firecracker
LOOM_FIRECRACKER_EVIDENCE_DIR=/var/lib/loom/evidence
LOOM_FIRECRACKER_KERNEL=/var/lib/loom/firecracker/kernel/vmlinux
LOOM_FIRECRACKER_ROOTFS=/var/lib/loom/firecracker/rootfs.ext4
LOOM_FIRECRACKER_VCPUS=2
LOOM_FIRECRACKER_MEMORY_MB=4096
LOOM_FIRECRACKER_VERSION=1.16.1
FIRECRACKER_BIN=/usr/local/bin/firecracker

# Production backup and disaster recovery
LOOM_BACKUP_ENCRYPTION_KEY=replace-with-fernet-key
LOOM_WEBHOOK_SECRET_KEY=replace-with-fernet-key
LOOM_EVIDENCE_DIR=~/.loom/evidence
LOOM_BACKUP_S3_BUCKET=replace-with-offsite-backup-bucket
LOOM_BACKUP_S3_PREFIX=loom/backups
LOOM_BACKUP_S3_ENDPOINT_URL=
LOOM_BACKUP_INTERVAL_SECONDS=3600
LOOM_BACKUP_RETENTION_COUNT=24
AWS_REGION=us-east-1

# Inbound webhook verification secrets
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITLAB_WEBHOOK_SECRET=replace-with-gitlab-webhook-secret
SLACK_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com

# Model Routing & LLM Provider Keys
MODEL_DEFAULT=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Storage & Database Options
LOOM_HOME=~/.loom
LOOM_DB_PATH=~/.loom/memory.db
DATABASE_URL=postgresql://loom:password@localhost:5432/loom
POSTGRES_PASSWORD=replace-with-random-postgres-password

# Telemetry & Observability Exporters
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Frontend & BFF Configuration
LOOM_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
