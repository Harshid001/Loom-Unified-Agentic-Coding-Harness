# Loom Harness API & Environment Configuration

# Runtime / production security
LOOM_ENV=development
API_KEY=your-secret-api-key-here
DASHBOARD_AUTH_TOKEN=your-dashboard-auth-token-here
ALLOWED_REPO_ROOTS=/var/repos,/app/workspaces
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=redis://localhost:6379/0
LOOM_TOKEN_ADMIN_ENABLED=false

# Production sandbox worker
LOOM_SANDBOX_WORKER_URL=http://sandbox-worker:8100
SANDBOX_WORKER_TOKEN=replace-with-random-worker-token
SANDBOX_ALLOW_NETWORK=false
DOCKER_GID=999

# Production backup and disaster recovery
LOOM_BACKUP_ENCRYPTION_KEY=replace-with-fernet-key
LOOM_EVIDENCE_DIR=~/.loom/evidence
LOOM_BACKUP_S3_BUCKET=replace-with-offsite-backup-bucket
LOOM_BACKUP_S3_PREFIX=loom/backups
LOOM_BACKUP_S3_ENDPOINT_URL=
LOOM_BACKUP_INTERVAL_SECONDS=3600
LOOM_BACKUP_RETENTION_COUNT=24
AWS_REGION=us-east-1

# IMPORTANT SECURITY NOTICE FOR PRODUCTION:
# Never commit real credentials to version control.
# Store production secrets in a dedicated secrets manager such as HashiCorp Vault,
# AWS Secrets Manager, Azure Key Vault, or GCP Secret Manager.

# Model Routing & LLM Provider Keys
MODEL_DEFAULT=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Storage & Database Options
LOOM_DB_PATH=~/.loom/memory.db
DATABASE_URL=postgresql://loom:password@localhost:5432/loom
POSTGRES_PASSWORD=replace-with-random-postgres-password

# Telemetry & Observability Exporters
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Frontend & BFF Configuration
LOOM_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
