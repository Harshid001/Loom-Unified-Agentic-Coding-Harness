# Loom API / worker / backup environment — /etc/loom/loom.env
# Copy from infra/systemd/loom.env.example and fill in secrets.

LOOM_ENV=production

# --- Authentication ---
API_KEY=CHANGE_ME_api_key
DASHBOARD_AUTH_TOKEN=CHANGE_ME_dashboard_token

# --- Infrastructure ---
DATABASE_URL=postgresql://loom:CHANGE_ME_db_password@127.0.0.1:5432/loom
REDIS_URL=redis://127.0.0.1:6379/0

# --- Repository roots the harness may touch ---
ALLOWED_REPO_ROOTS=/var/repos

# --- Tier B/C Firecracker worker (Linux + KVM host only) ---
LOOM_FIRECRACKER_WORKER_URL=http://127.0.0.1:8101
LOOM_FIRECRACKER_WORKER_TOKEN=CHANGE_ME_firecracker_token
LOOM_SANDBOX_WORKER_URL=http://127.0.0.1:8101
SANDBOX_WORKER_TOKEN=CHANGE_ME_firecracker_token

# --- Backups ---
LOOM_BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_byte_encryption_key
LOOM_BACKUP_S3_BUCKET=
AWS_DEFAULT_REGION=
LOOM_BACKUP_DIR=/home/loom/.loom/backups
LOOM_BACKUP_STATUS_FILE=/home/loom/.loom/backups/backup-status.json
LOOM_BACKUP_INTERVAL_SECONDS=3600
LOOM_BACKUP_RETENTION_COUNT=24

# --- Run budget ---
LOOM_MAX_RUN_COST_USD=50.0
LOOM_MAX_RUN_DURATION_SECONDS=3600
LOOM_MAX_RUN_TOKENS=500000

# --- API bind ---
HOST=127.0.0.1
PORT=8000
LOOM_TOKEN_ADMIN_ENABLED=false

# --- Model provider keys (hosted server-side; users bring none) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=