# Vercel Deployment Environment Variables for Loom Dashboard

# URL of your deployed Loom FastAPI Backend API (e.g. https://api.yourdomain.com, Railway, Render, Fly.io, or AWS)
LOOM_API_URL=https://api.yourdomain.com

# Dashboard Session & Auth Token (must match the DASHBOARD_AUTH_TOKEN on backend)
DASHBOARD_AUTH_TOKEN=your-secure-dashboard-token-here

# API Key for backend communication
API_KEY=your-backend-api-key-here
LOOM_API_KEY=your-backend-api-key-here

# Optional session encryption secret (defaults to DASHBOARD_AUTH_TOKEN if unset)
DASHBOARD_SESSION_SECRET=your-random-session-secret-here

# Origin URL of this Vercel deployment (e.g. https://loom-harness.vercel.app)
NEXT_PUBLIC_APP_ORIGIN=https://loom-harness.vercel.app

# Google OAuth 2.0 Credentials (for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Optional: comma-separated list of permitted emails (leave blank to allow all authenticated Google accounts)
ALLOWED_GOOGLE_EMAILS=
